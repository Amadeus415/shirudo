From d1a694bee6e52463f14124d437b8ae7843845b13 Mon Sep 17 00:00:00 2001
From: Alexei Starovoitov <alexei.starovoitov@gmail.com>
Date: Mon, 9 Nov 2026 21:39:59 +0000
Subject: [PATCH] bpf: Match struct_ops members by name in the kernel

A light skeleton doesn't know the struct_ops of the running kernel when
bpftool generates it. Let the kernel find its struct_ops and the members
by the names that they have in the BTF of the object like
btf_parse_kptr() finds the type of a kptr.

BPF_MAP_CREATE of BPF_MAP_TYPE_STRUCT_OPS takes btf_fd, btf_value_type_id
and value_size of the struct in the BTF of the object. BPF_PROG_LOAD of
BPF_PROG_TYPE_STRUCT_OPS takes attach_btf_obj_fd = btf_fd, attach_btf_id =
that struct and expected_attach_type = index of its member.
BPF_MAP_UPDATE_ELEM takes that struct with the prog fds in it.

The kernel rejects such BPF_MAP_CREATE and BPF_PROG_LOAD today. Nothing
changes for existing users. The BTF of the object is in the blob so the
signature covers the names.

Link: https://lore.kernel.org/bpf/DMR088J2OR6L.9TOD4IDBHTZ8@gmail.com/
---
 include/linux/bpf.h            |  10 ++
 include/uapi/linux/bpf.h       |  15 ++-
 kernel/bpf/bpf_struct_ops.c    | 214 ++++++++++++++++++++++++++++++++-
 kernel/bpf/syscall.c           |  14 ++-
 tools/include/uapi/linux/bpf.h |  15 ++-
 5 files changed, 255 insertions(+), 13 deletions(-)

diff --git a/include/linux/bpf.h b/include/linux/bpf.h
index b011acc22c50..988d3f8c35e8 100644
--- a/include/linux/bpf.h
+++ b/include/linux/bpf.h
@@ -2432,6 +2432,8 @@ void bpf_struct_ops_put(const void *kdata);
 int bpf_struct_ops_supported(const struct bpf_struct_ops *st_ops, u32 moff);
 int bpf_struct_ops_map_sys_lookup_elem(struct bpf_map *map, void *key,
 				       void *value);
+u32 bpf_struct_ops_map_update_size(const struct bpf_map *map);
+int bpf_struct_ops_resolve_attach(struct btf **btf, union bpf_attr *attr);
 int bpf_struct_ops_prepare_trampoline(struct bpf_tramp_nodes *tnodes,
 				      struct bpf_tramp_node *node,
 				      const struct btf_func_model *model,
@@ -2509,6 +2511,14 @@ static inline int bpf_struct_ops_map_sys_lookup_elem(struct bpf_map *map,
 {
 	return -EINVAL;
 }
+static inline u32 bpf_struct_ops_map_update_size(const struct bpf_map *map)
+{
+	return map->value_size;
+}
+static inline int bpf_struct_ops_resolve_attach(struct btf **btf, union bpf_attr *attr)
+{
+	return -ENOTSUPP;
+}
 static inline int bpf_struct_ops_link_create(union bpf_attr *attr)
 {
 	return -EOPNOTSUPP;
