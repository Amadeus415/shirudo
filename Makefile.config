# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 Authors of shirudo
#
# Makefile.config -- feature-detection probes.
#
# Driven by the top-level Makefile. Writes a cached config.mk that
# Makefile.shirudo -includes. Re-runs on `make distclean` (the cache
# file is removed) or when this file is edited (timestamp-driven).
#
# All probes fail loud and actionable; there is no legacy-fallback
# path in shirudo. The bar is "current upstream kernel + current
# upstream clang" -- if a prerequisite is missing, the build aborts
# with an explicit install hint.

PKG_CONFIG ?= pkg-config
CC         ?= cc

# Each probe sets a yes/no string and (on yes) records the cflags +
# libs that the actual build will use.
probe-libcrypto    := $(shell $(PKG_CONFIG) --exists libcrypto && echo yes)
probe-libssh       := $(shell $(PKG_CONFIG) --exists "libssh >= 0.10" && echo yes)
probe-tss2-esys    := $(shell $(PKG_CONFIG) --exists "tss2-esys >= 4.0" && echo yes)
probe-tss2-tctildr := $(shell $(PKG_CONFIG) --exists tss2-tctildr && echo yes)
probe-libelf       := $(shell $(PKG_CONFIG) --exists libelf && echo yes)
probe-zlib         := $(shell $(PKG_CONFIG) --exists zlib && echo yes)
probe-libcurl       := $(shell $(PKG_CONFIG) --exists "libcurl >= 7.75" && echo yes)
probe-luajit        := $(shell $(PKG_CONFIG) --exists luajit && echo yes)

probe-clang-bpf := $(shell printf 'int main(void){return 0;}\n' | \
                     clang -target bpf -x c -c -o /dev/null - 2>/dev/null && echo yes)

# Probe the bpf-next UAPI headers shirudo builds against -- not the
# host's /usr/include/linux/bpf.h, which on stock distros lags the
# kernel by months. Falls back to the system headers if the submodule
# tree isn't present (e.g. tarball builds).
BPF_NEXT_UAPI := third_party/bpf-next/tools/include/uapi
probe-keyring-id := $(shell printf '%s\n%s\n%s\n' \
                     '#include <stddef.h>' \
                     '#include <linux/bpf.h>' \
                     'int x = offsetof(union bpf_attr, keyring_id);' | \
                     $(CC) -xc -I $(BPF_NEXT_UAPI) -c -o /dev/null - \
                     2>/dev/null && echo yes)

.PHONY: config.mk
config.mk:
	@:; \
	fail=0; \
	check() { \
	    local name="$$1" got="$$2" hint="$$3"; \
	    if [ "$$got" != "yes" ]; then \
	        printf 'shirudo: missing prerequisite: %s\n' "$$name" >&2; \
	        printf '         %s\n' "$$hint" >&2; \
	        fail=1; \
	    fi; \
	}; \
	check "libcrypto"        "$(probe-libcrypto)" \
	      "install libssl-dev / openssl-devel"; \
	check "libssh >= 0.10"   "$(probe-libssh)" \
	      "install libssh-dev (>= 0.10) / libssh-devel"; \
	check "tss2-esys >= 4.0" "$(probe-tss2-esys)" \
	      "install libtss2-dev / tpm2-tss-devel"; \
	check "tss2-tctildr"     "$(probe-tss2-tctildr)" \
	      "install libtss2-dev / tpm2-tss-devel"; \
	check "libelf"           "$(probe-libelf)" \
	      "install libelf-dev / elfutils-libelf-devel"; \
	check "zlib"             "$(probe-zlib)" \
	      "install zlib1g-dev / zlib-devel"; \
	check "libcurl >= 7.75"  "$(probe-libcurl)" \
	      "install libcurl4-openssl-dev / libcurl-devel"; \
	check "luajit"           "$(probe-luajit)" \
	      "install libluajit-5.1-dev / luajit-devel"; \
	check "clang -target bpf" "$(probe-clang-bpf)" \
	      "install current upstream clang/llvm"; \
	check "kernel UAPI keyring_id" "$(probe-keyring-id)" \
	      "kernel UAPI headers too old; install current upstream linux-libc-dev"; \
	if [ "$$fail" = "1" ]; then exit 1; fi; \
	{ \
	    echo "# SPDX-License-Identifier: BSD-2-Clause"; \
	    echo "# AUTO-GENERATED by Makefile.config. Do not edit; do not commit."; \
	    echo "LIBCRYPTO_CFLAGS := $$($(PKG_CONFIG) --cflags libcrypto)"; \
	    echo "LIBCRYPTO_LIBS   := $$($(PKG_CONFIG) --libs libcrypto)"; \
	    echo "LIBSSH_CFLAGS    := $$($(PKG_CONFIG) --cflags libssh)"; \
	    echo "LIBSSH_LIBS      := $$($(PKG_CONFIG) --libs libssh)"; \
	    echo "TSS2_CFLAGS      := $$($(PKG_CONFIG) --cflags tss2-esys tss2-tctildr)"; \
	    echo "TSS2_LIBS        := $$($(PKG_CONFIG) --libs tss2-esys tss2-tctildr)"; \
	    echo "LIBELF_CFLAGS    := $$($(PKG_CONFIG) --cflags libelf)"; \
	    echo "LIBELF_LIBS      := $$($(PKG_CONFIG) --libs libelf)"; \
	    echo "ZLIB_CFLAGS      := $$($(PKG_CONFIG) --cflags zlib)"; \
	    echo "ZLIB_LIBS        := $$($(PKG_CONFIG) --libs zlib)"; \
	    echo "LIBCURL_CFLAGS   := $$($(PKG_CONFIG) --cflags libcurl)"; \
	    echo "LIBCURL_LIBS     := $$($(PKG_CONFIG) --libs libcurl)"; \
	    echo "HAVE_LUAJIT      := $(probe-luajit)"; \
	    echo "LUAJIT_CFLAGS    := $$($(PKG_CONFIG) --cflags luajit 2>/dev/null)"; \
	    echo "LUAJIT_LIBS      := $$($(PKG_CONFIG) --libs luajit 2>/dev/null)"; \
	} > config.mk
	@printf 'shirudo: wrote %s\n' "$@"
