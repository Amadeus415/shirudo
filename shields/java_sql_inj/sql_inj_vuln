#!/bin/sh
# Run the vulnerable H2 application used by the Java SQL injection example.

set -eu

ENV_FILE=/etc/environment.d/shirudo.conf
APP_JAR=/usr/local/share/shirudo/java_sql_inj/vulnerable-app.jar

# environment.d is consumed by system environment generators, not by every
# non-login SSH command. Source this small assignment explicitly for the VM
# demo so the command has the same behavior in both cases.
if [ -r "$ENV_FILE" ]; then
	. "$ENV_FILE"
	export JAVA_TOOL_OPTIONS
fi

exec /usr/bin/java -jar "$APP_JAR" "$@"
