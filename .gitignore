/shirudo
/shirudo-target
/shirudo-build
/shirudo.tar.gz
/shirudo-static.tar.gz
/shirudo-target.deb
/shirudo-operator.deb
/tools/shirudo-build/shirudo-build
*.o
*.d
*.a
*.so
*.so.*
*.upatch
*.upatch.json

# Local bpf-next kernel and userspace dependency artifacts
/artifacts/

# Generated headers
/vmlinux.h
/vendor/linux/
*.skel.h

# Generated systemd units (from systemd/*.service.in)
/systemd/shirudo.service
/systemd/shirudo-map-export.service
/systemd/shirudo-keepalive.service
/systemd/shirudo-bpm-repo-update.service
/systemd/shirudo-bpm-tree-sync.service

# Vendored bpf-next build state (do not commit)

# Test results
/t/test-results/
/t/trash directory.*
*.tap

# Compiled test helpers (sources are tracked)
/t/helper/*
!/t/helper/*.c
!/t/helper/otel-mock.py
!/t/helper/otel-s3-mock.py
!/t/helper/test-bpm-key.py
!/t/helper/test-bpm-info.py

# Local config (PLAN.md "Build system": Makefile.config is a committed
# probe file that writes the cached config.mk; util/version_id.c is
# regenerated every build).
.config
config.mk
config-target.mk
util/version_id.c

# Editor / OS noise
*.swp
*.swo
*~
.DS_Store

# Coverage / sanitisers
*.gcda
*.gcno
/coverage/

# vendored libbpf build outputs and the build-time vmlinux.h generator
/vendor/libbpf/bpf/*.o
/vendor/libbpf/bpf/*.d
/vendor/libbpf/libbpf.a
/tools/gen-vmlinux-h/gen-vmlinux-h
