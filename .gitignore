# Build artefacts
/build/
/shirudo
/shirudo-build
/shirudo.tar.gz
/shirudo-static.tar.gz
/shirudo-target.deb
/shirudo-operator.deb
/tools/shirudo-build/shirudo-build
*.o
*.d
*.a
*.so
*.so.*
*.upatch
*.upatch.json

# Local bpf-next kernel and userspace dependency artifacts
/artifacts/

# Generated headers
/vmlinux.h
/bpf/vmlinux.h
/packaging/bpf/vmlinux.h
*.skel.h

# Generated systemd units (from systemd/*.service.in)
/systemd/shirudo.service
/systemd/shirudo-map-export.service
/systemd/shirudo-keepalive.service

# BPF-side headers copied from third_party/bpf-next at build time
/bpf/include/

# Vendored bpf-next build state (do not commit)
/third_party/bpf-next/tools/lib/bpf/*.o
/third_party/bpf-next/tools/lib/bpf/*.a
/third_party/bpf-next/tools/lib/subcmd/*.o
/third_party/bpf-next/tools/lib/subcmd/*.a
/third_party/bpf-next/tools/bpf/bpftool/bpftool
/third_party/bpf-next/tools/bpf/bpftool/*.o

# Test results
/t/test-results/
/t/trash directory.*
*.tap

# Compiled test helpers (sources are tracked)
/t/helper/*
!/t/helper/*.c
!/t/helper/otel-s3-mock.py

# Local config (PLAN.md "Build system": Makefile.config is a committed
# probe file that writes the cached config.mk; util/version_id.c is
# regenerated every build).
.config
config.mk
util/version_id.c

# Editor / OS noise
*.swp
*.swo
*~
.DS_Store

# Coverage / sanitisers
*.gcda
*.gcno
/coverage/
