# Each harness of this directory and the CBMC options it runs with.
# --unwind must exceed the longest loop the harness's bound allows.
string-number		--unwind 24
string-utf8		--unwind 10
string-copy		--unwind 10
string-suffix		--unwind 8
string-sanitize		--unwind 8 LEN=0-6
hex			--unwind 12
paths-bpffs-name	--unwind 18
string-number-model	--unwind 6
bpm-tree-follows	--unwind 4
bpm-tree-sync-model	--unwind 60 --max-field-sensitivity-array-size 257 LEN=0-2
log-escape		--unwind 7 LEN=0-5
otel-header-fields	-I ../../../vendor/libbpf -I ../../../vendor/libbpf/include/uapi -D__NO_CTYPE --unwind 34 --unwindset strchr.0:17 LEN=32
otel-retry-after	-I ../../../vendor/libbpf -I ../../../vendor/libbpf/include/uapi -D__NO_CTYPE --unwind 1 --unwindset response_header.0:33,response_header.1:33,otel_retry_after.0:33,otel_retry_after.1:33,delay.0:33,strlen.0:34,strncasecmp.0:13 LEN=32
bpm-tree-selector	--unwind 10 --malloc-may-fail --malloc-fail-null LEN=0,1
bpm-tree-reader		--unwind 6 --malloc-may-fail --malloc-fail-null LEN=0,1
hex-model		--unwind 20
paths-bpffs-name-model	--unwind 20
