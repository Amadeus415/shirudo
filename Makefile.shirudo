# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 Authors of shirudo
#
# Makefile.shirudo -- main build graph.
#
# Five strict build phases (see PLAN.md "Build phases"):
#   1. submodule libraries (libbpf.a, libelf.a, bpftool)
#   2. generated headers   (bpf/vmlinux.h)
#   3. compiled objects    (util/*.o, builtin-*.o, shirudo.o, bpf/*.bpf.o)
#   4. embedded BPF        (util/loader.o, .incbin of bpf/*.bpf.o)
#   5. link                (shirudo, shirudo-target, shirudo-build)

include Makefile.version

PROFILE ?= operator
CONFIG_MK ?= config.mk
-include $(CONFIG_MK)

ifeq ($(PROFILE),target)
OBJ_PREFIX := build/target/
CRYPTO_SRC := util/crypto_mbedtls.c
CRYPTO_CFLAGS := $(TARGET_MBEDTLS_CFLAGS)
CRYPTO_DEFINE := -DSHIRUDO_CRYPTO_MBEDTLS
else
OBJ_PREFIX :=
CRYPTO_SRC := util/crypto_openssl.c
CRYPTO_CFLAGS :=
CRYPTO_DEFINE := -DSHIRUDO_CRYPTO_OPENSSL
endif

obj = $(OBJ_PREFIX)$(1)

# ----- toolchain --------------------------------------------------

CC      ?= cc
LD      := $(CC)
LDFLAGS ?=
SHIRUDO_BUNDLE_RPATH ?= 0
CLANG   ?= clang
BPF_NEXT_DEPS_DIR ?= artifacts/bpf-next-kernel-debs/shirudo-bpf-deps
USE_BPF_NEXT_DEPS ?= 0
BPFTOOL_SOURCE_DIR := third_party/bpf-next/tools/bpf/bpftool
LIBBPF_SOURCE_DIR  := third_party/bpf-next/tools/lib/bpf
BPF_VMLINUX_H ?=
# Prefer the BTF emitted by `make bpf-next`; otherwise use the running host.
# A caller can still override this explicitly for another target kernel.
BPF_VMLINUX_BTF ?= $(if $(wildcard artifacts/bpf-next-kernel-debs/vmlinux.btf),artifacts/bpf-next-kernel-debs/vmlinux.btf,/sys/kernel/btf/vmlinux)

ifeq ($(USE_BPF_NEXT_DEPS),1)
  ifneq ($(wildcard $(BPF_NEXT_DEPS_DIR)/bpftool),$(BPF_NEXT_DEPS_DIR)/bpftool)
    $(error USE_BPF_NEXT_DEPS=1 requires $(BPF_NEXT_DEPS_DIR)/bpftool; run make bpf-next)
  endif
  ifneq ($(wildcard $(BPF_NEXT_DEPS_DIR)/bpf/libbpf.a),$(BPF_NEXT_DEPS_DIR)/bpf/libbpf.a)
    $(error USE_BPF_NEXT_DEPS=1 requires $(BPF_NEXT_DEPS_DIR)/bpf/libbpf.a; run make bpf-next)
  endif
  ifneq ($(wildcard $(BPF_NEXT_DEPS_DIR)/vmlinux.h),$(BPF_NEXT_DEPS_DIR)/vmlinux.h)
    $(error USE_BPF_NEXT_DEPS=1 requires artifacts in $(BPF_NEXT_DEPS_DIR); run make bpf-next)
  endif
  BPFTOOL ?= $(BPF_NEXT_DEPS_DIR)/bpftool
  BPF_TOOLS_LIB_ROOT ?= $(BPF_NEXT_DEPS_DIR)
  ifeq ($(strip $(BPF_VMLINUX_H)),)
    BPF_VMLINUX_H := $(BPF_NEXT_DEPS_DIR)/vmlinux.h
  endif
else
  BPFTOOL ?= $(BPFTOOL_SOURCE_DIR)/bpftool
  BPF_TOOLS_LIB_ROOT ?= third_party/bpf-next/tools/lib
endif

SHIRUDO_LIBEXEC_DIR ?= $(libexecdir)/shirudo
SHIRUDO_JAVAAGENT_LIBDIR ?= /usr/lib/shirudo

# JNI is needed only for the target-side Java-agent bridge. Keep the main
# binary build independent of a JDK, while install-target builds the bridge.
JAVA_HOME ?= $(shell javac_path=$$(command -v javac 2>/dev/null); \
	[ -n "$$javac_path" ] && dirname "$$(dirname "$$(readlink -f "$$javac_path")")")

# Where operator-installed BPF headers live on a packaged host;
# also baked into shirudo-build as a runtime fallback -I path.
SHIRUDO_BPF_INCDIR  ?= $(sharedir)/shirudo/bpf/include
# Installed kernel BTF types used as the default vmlinux.h fallback.
SHIRUDO_VMLINUX_PATH ?= $(sharedir)/shirudo/vmlinux.h

WARNINGS := -Wall -Wextra -Wno-unused-parameter -Wstrict-prototypes \
            -Wmissing-prototypes -Wpointer-arith -Wshadow

SHIRUDO_DEBUG ?= 1
DEBUG_CFLAGS := $(if $(filter 1 yes y true,$(SHIRUDO_DEBUG)),-g,)

CFLAGS_BASE := -O2 $(DEBUG_CFLAGS) -std=gnu11 $(WARNINGS) \
               -D_FILE_OFFSET_BITS=64 -D_GNU_SOURCE \
               -DSHIRUDO_LIBEXEC_DIR='"$(SHIRUDO_LIBEXEC_DIR)"' \
               -DSHIRUDO_BPF_INCDIR='"$(SHIRUDO_BPF_INCDIR)"' \
               -DSHIRUDO_VMLINUX_PATH='"$(SHIRUDO_VMLINUX_PATH)"'

INCLUDES := \
    -I. \
    -Iinclude \
    -Iutil \
    -I$(BPF_TOOLS_LIB_ROOT) \
    -Ithird_party/bpf-next/tools/include/uapi

CFLAGS := $(CFLAGS_BASE) $(INCLUDES) \
          $(LIBCRYPTO_CFLAGS) $(TSS2_CFLAGS) \
          $(LIBELF_CFLAGS) $(ZLIB_CFLAGS) $(LIBCURL_CFLAGS) \
          $(CRYPTO_CFLAGS) $(CRYPTO_DEFINE)

# libbpf is always linked from its archive. The normal shirudo binary keeps
# the existing dynamic OpenSSL/libcurl profile for operator builds.
STATIC_LIBS = \
    $(LIBBPF_A)

DYNAMIC_LIBS := \
    $(LIBCRYPTO_LIBS) -lssl $(TSS2_LIBS) \
    $(LIBELF_LIBS) $(ZLIB_LIBS) $(LIBCURL_LIBS)

CFLAGS += $(LUAJIT_CFLAGS) -DSHIRUDO_HAVE_LUAJIT
DYNAMIC_LIBS += $(LUAJIT_LIBS)

ifeq ($(SHIRUDO_BUNDLE_RPATH),1)
RPATH_LDFLAGS := -Wl,--disable-new-dtags -Wl,-rpath,'$$ORIGIN/../lib/shirudo'
else
RPATH_LDFLAGS :=
endif

# vmlinux.h dumps anonymous structs in a way that trips
# -Wmissing-declarations; the BPF_PROG() / BPF_KPROBE() macros
# generate auto-named params that often go unused. Neither is
# fixable upstream of us, so silence both for BPF compilation.
CLANG_BPF := $(CLANG) -target bpf -O2 -g -Wall -Wextra \
             -Wno-missing-declarations -Wno-unused-parameter

# ----- source manifests -------------------------------------------

UTIL_SRCS := \
	$(CRYPTO_SRC) \
    util/parse-options.c \
    util/loader.c \
    util/upatch.c \
    util/keyring.c \
    util/paths.c \
    util/harden.c \
    util/preflight.c \
    util/kernel_abi.c \
    util/log.c \
    util/io.c \
    util/tpm.c \
    util/chain.c \
    util/bpm_tree.c \
    util/kernel_build_id.c \
    util/kernel_release.c \
    util/config.c \
    util/mode.c \
    util/bpm_source_config.c \
    util/eventlog.c \
    util/json.c \
    util/report.c \
    util/malloc.c \
    util/sysinfo.c \
    util/similar.c \
    util/help.c \
    util/timefmt.c \
    util/conditions.c \
    util/format.c \
    util/kmsg.c \
    util/kmodules.c \
    util/seal.c \
    util/serializer.c \
    util/upatch_maps.c \
    util/upatch_decode.c \
    util/upatch_maps_otel.c \
    util/elf_target.c \
    util/upatch_resolve.c \
    util/upatch_table.c

ifeq ($(PROFILE),target)
BUILTIN_GENKEY_SRC := builtin-genkey-mbedtls.c
else
BUILTIN_GENKEY_SRC := builtin-genkey.c
endif

BUILTIN_SRCS := \
    builtin-init.c \
    $(BUILTIN_GENKEY_SRC) \
    builtin-status.c \
    builtin-keys.c \
    builtin-config.c \
    builtin-upatch.c \
    builtin-bpm.c \
    builtin-build.c \
    builtin-version.c

# BPF-side libbpf headers we vendor at build time. bpf_helper_defs.h
# is generated by libbpf's own Makefile, so this list depends on
# LIBBPF_A. Copies into bpf/include/bpf/ so the BPF compile rule
# can use the kernel-selftest -I convention (`<bpf/...>`).
BPF_VENDOR_HEADERS := bpf_helpers bpf_helper_defs bpf_tracing \
                      bpf_core_read bpf_endian
BPF_HEADERS_OUT    := $(addprefix bpf/include/bpf/,\
                                  $(addsuffix .h,$(BPF_VENDOR_HEADERS)))
BPF_LIB_HEADERS    := bpf/lib/shirudo_bpf_common.h \
                      bpf/lib/shirudo_serializer.h \
                      bpf/lib/shirudo_decoder.h

# bpf/*.bpf.c sources compiled with clang -target bpf and embedded via
# .incbin into util/loader.o. bpf/lib/ is include-only.
BPF_SRCS := \
    bpf/bpf2.c \
    bpf/bpf2-trusted-root.c \
    bpf/seal.c \
    bpf/unload.c

JAVAAGENT_BRIDGE := util/libshirudo_javaagent.so

# shirudo-build is operator-only and links util/sign.c (CMS signer)
# plus a small subset of util/. The core shirudo binary does NOT
# link util/sign.c.
BUILD_SRCS := \
    tools/shirudo-build/shirudo-build.c \
    tools/shirudo-build/compile.c \
    tools/shirudo-build/package.c \
    tools/shirudo-build/vmlinux.c

# ----- derived names ----------------------------------------------

UTIL_OBJS    := $(foreach s,$(UTIL_SRCS),$(call obj,$(s:.c=.o)))
BUILTIN_OBJS := $(foreach s,$(BUILTIN_SRCS),$(call obj,$(s:.c=.o)))
BPF_OBJS     := $(BPF_SRCS:.c=.bpf.o)
BUILD_OBJS   := $(foreach s,$(BUILD_SRCS),$(call obj,$(s:.c=.o)))

MAIN_OBJ     := $(call obj,shirudo.o)
VERSION_OBJ  := $(call obj,util/version_id.o)

# Header-dependency tracking (-MMD -MP writes a .d per .o). Without this,
# changing a header would leave dependent .o files stale -- e.g. a struct
# whose size grew in a header but whose .c was not re-touched, producing
# an ABI mismatch and memory corruption at runtime.
DEP_OBJS := $(MAIN_OBJ) $(BUILTIN_OBJS) $(UTIL_OBJS) $(VERSION_OBJ) \
            $(BUILD_OBJS)
DEPS     := $(DEP_OBJS:.o=.d)

# ----- top-level goals --------------------------------------------

.PHONY: all install install-common install-target install-operator clean distclean check test \
		test-helpers \
		javaagent-bridge \
        bpf libbpf bpftool

all: shirudo

# shirudo-build is built only when explicitly requested or on the
# operator install target.
shirudo-build: tools/shirudo-build/shirudo-build

# ----- phase 1: submodule libraries -------------------------------

LIBBPF_DIR ?= $(BPF_TOOLS_LIB_ROOT)/bpf
LIBBPF_A   ?= $(LIBBPF_DIR)/libbpf.a

libbpf: $(LIBBPF_A)

# libbpf's Makefile has no narrow "libbpf.a" target; the default
# target builds both libbpf.a, libbpf.so, and the generated
# bpf_helper_defs.h that BPF programs include. We consume libbpf.a
# and bpf_helper_defs.h; the .so is harmless byproduct.
$(LIBBPF_A):
	@printf '  LIBBPF\n'
	$(Q)$(MAKE) -C $(LIBBPF_SOURCE_DIR) CC="$(CC)"

BPFTOOL_DIR := $(BPFTOOL_SOURCE_DIR)

bpftool: $(BPFTOOL)

$(BPFTOOL):
	@printf '  BPFTOOL\n'
	$(Q)$(MAKE) -C $(BPFTOOL_DIR) CC="$(CC)"

# ----- phase 2: generated headers ---------------------------------

ifneq ($(BPF_VMLINUX_H),)
bpf/vmlinux.h: $(BPF_VMLINUX_H)
	@printf '  COPY    $@\n'
	$(Q)cp $< $@
else
bpf/vmlinux.h: $(BPFTOOL)
	@printf '  GEN     $@\n'
	$(Q)$< btf dump file $(BPF_VMLINUX_BTF) format c > $@
endif

# ----- phase 3: compile rules -------------------------------------

%.o: %.c
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

build/target/%.o: %.c
	@printf '  CC      $@\n'
	$(Q)mkdir -p $(dir $@)
	$(Q)$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

-include $(DEPS)

# Vendor the BPF-side libbpf headers into bpf/include/bpf/. The
# generated bpf_helper_defs.h only exists after libbpf is built.
$(BPF_HEADERS_OUT): bpf/include/bpf/%.h: $(LIBBPF_A)
	@printf '  COPY    $@\n'
	$(Q)mkdir -p $(dir $@)
	$(Q)cp $(LIBBPF_DIR)/$*.h $@

# BPF objects pull <bpf/...> headers from the in-tree vendor dir,
# vmlinux.h from bpf/, and UAPI kernel headers from the submodule.
bpf/%.bpf.o: bpf/%.c bpf/vmlinux.h $(BPF_HEADERS_OUT)
	@printf '  CLANG   $@\n'
	$(Q)$(CLANG_BPF) -Ibpf -Ibpf/lib -Ibpf/include \
	    -Ithird_party/bpf-next/tools/include/uapi \
	    -c $< -o $@

bpf/bpf2-trusted-root.bpf.o: bpf/bpf2.c

# ----- version_id ------------------------------------------------

# Regenerated every build; cheap (one sha256sum invocation).
.PHONY: util/version_id.c
util/version_id.c:
	@printf '  GEN     $@\n'
	$(Q)set -eu; \
	describe=$$($(SHIRUDO_GIT_DESCRIBE) 2>/dev/null || cat VERSION); \
	describe_c=$$(printf '%s' "$$describe" | sed 's/[\\"]/\\&/g'); \
	rev=$$(git rev-parse HEAD 2>/dev/null || cat VERSION); \
	dirty=$$(git diff-index --quiet HEAD 2>/dev/null || echo -dirty); \
	cfg=$$(sha256sum config.mk Makefile.shirudo 2>/dev/null | \
	       sha256sum | cut -c1-16); \
	id=$$(printf '%s%s|%s' "$$rev$$dirty" "$$cfg" | \
	      sha256sum | cut -d' ' -f1); \
	extra_c=$$(printf '%s' "$(EXTRAVERSION)" | sed 's/[\\"]/\\&/g'); \
	name_c=$$(printf '%s' "$(NAME)" | sed 's/[\\"]/\\&/g'); \
	{ \
	    echo "// SPDX-License-Identifier: BSD-2-Clause"; \
	    echo "/* Copyright (c) 2026 Authors of shirudo */"; \
	    echo "/* AUTO-GENERATED. Do not edit. Do not commit. */"; \
	    echo ""; \
	    echo "const char shirudo_version[] = \"$$describe_c\";"; \
	    echo "const char shirudo_version_id[] = \"$$id\";"; \
	    echo "const char shirudo_extraversion[] = \"$$extra_c\";"; \
	    echo "const char shirudo_release_name[] = \"$$name_c\";"; \
	} > $@

# ----- phase 5: link ---------------------------------------------

shirudo: $(MAIN_OBJ) $(BUILTIN_OBJS) $(UTIL_OBJS) $(VERSION_OBJ) $(LIBBPF_A)
	@printf '  LD      $@\n'
	$(Q)$(LD) $(CFLAGS) $(LDFLAGS) $(RPATH_LDFLAGS) -o $@ \
	    $(MAIN_OBJ) $(BUILTIN_OBJS) $(UTIL_OBJS) $(VERSION_OBJ) \
	    $(STATIC_LIBS) $(DYNAMIC_LIBS)

shirudo-target: $(MAIN_OBJ) $(BUILTIN_OBJS) $(UTIL_OBJS) $(VERSION_OBJ) $(LIBBPF_A)
	@printf '  LD      $@ (static mbedTLS)\n'
	$(Q)$(LD) $(CFLAGS) $(TARGET_MBEDTLS_CFLAGS) $(LDFLAGS) $(RPATH_LDFLAGS) -o $@ \
	    $(MAIN_OBJ) $(BUILTIN_OBJS) $(UTIL_OBJS) $(VERSION_OBJ) \
	    $(STATIC_LIBS) $(TARGET_MBEDTLS_STATIC_LINK_LIBS) \
	    $(TARGET_STATIC_RUNTIME_LINK_LIBS) \
	    -Wl,-Bdynamic $(TARGET_MBEDTLS_DYNAMIC_LINK_LIBS)

# util/loader.o has a make-level dep on every embedded bpf object.
util/loader.o: $(BPF_OBJS)
build/target/util/loader.o: $(BPF_OBJS)

# shirudo-build links util/sign.c (CMS signer) plus a subset of util,
# plus util/loader.o for its .incbin of bpf/unload.bpf.o (used by
# the --unload directive emission path). Not linked into the core
# shirudo binary.
tools/shirudo-build/shirudo-build: $(BUILD_OBJS) util/sign.o \
                                   util/parse-options.o util/upatch.o \
                                   util/log.o util/json.o util/loader.o \
                                   util/io.o util/malloc.o util/paths.o \
                                   util/elf_target.o \
                                   $(LIBBPF_A)
	@printf '  LD      $@\n'
	$(Q)$(LD) $(CFLAGS) $(LDFLAGS) $(RPATH_LDFLAGS) -o $@ $^ $(STATIC_LIBS) $(DYNAMIC_LIBS)

$(JAVAAGENT_BRIDGE): util/javaagent_bridge.c
	@printf '  LD      $@\n'
	$(Q)test -n "$(JAVA_HOME)" && test -f "$(JAVA_HOME)/include/jni.h" || \
		{ echo "Java bridge requires a JDK (set JAVA_HOME)" >&2; exit 1; }
	$(Q)$(CC) $(CFLAGS) -fPIC -shared \
		-I"$(JAVA_HOME)/include" -I"$(JAVA_HOME)/include/linux" \
		-o $@ $< -pthread

javaagent-bridge: $(JAVAAGENT_BRIDGE)

# ----- install ----------------------------------------------------

# The reboot-persistence unit, with @bindir@ resolved to the install path.
systemd/shirudo.service: systemd/shirudo.service.in
	@printf '  GEN     $@\n'
	$(Q)sed 's|@bindir@|$(bindir)|g' $< > $@

# The periodic map exporter is target-only and uses the same installed binary.
systemd/shirudo-map-export.service: systemd/shirudo-map-export.service.in
	@printf '  GEN     $@\n'
	$(Q)sed 's|@bindir@|$(bindir)|g' $< > $@

# The periodic status keepalive is target-only and uses the same installed
# binary and OTLP environment as the map exporter.
systemd/shirudo-keepalive.service: systemd/shirudo-keepalive.service.in
	@printf '  GEN     $@\n'
	$(Q)sed 's|@bindir@|$(bindir)|g' $< > $@

# The BPM repository refresh is target-only and uses the same installed
# binary plus the optional BPM OCI environment file.
systemd/shirudo-bpm-repo-update.service: systemd/shirudo-bpm-repo-update.service.in
	@printf '  GEN     $@\n'
	$(Q)sed 's|@bindir@|$(bindir)|g' $< > $@

# The optional signed upatch tree refresh is target-only and exits cleanly
# when /etc/shirudo/bpm/upatch-tree.conf is absent.
systemd/shirudo-bpm-tree-sync.service: systemd/shirudo-bpm-tree-sync.service.in
	@printf '  GEN     $@\n'
	$(Q)sed 's|@bindir@|$(bindir)|g' $< > $@

install: shirudo install-common
	@printf '  INSTALL $(DESTDIR)$(bindir)/shirudo\n'
	$(Q)install -d $(DESTDIR)$(bindir)
	$(Q)install -m 0755 shirudo $(DESTDIR)$(bindir)/shirudo

install-common:
	@printf '  INSTALL $(DESTDIR)$(completionsdir)/shirudo\n'
	$(Q)install -d $(DESTDIR)$(completionsdir)
	$(Q)install -m 0644 completion/shirudo.bash \
	    $(DESTDIR)$(completionsdir)/shirudo

# Target machines additionally get the reboot-persistence, periodic map
# export, and status keepalive units. They are deliberately NOT in
# install-operator.
install-target: shirudo-target install-common javaagent-bridge systemd/shirudo.service \
		systemd/shirudo-map-export.service \
		systemd/shirudo-map-export.timer \
		systemd/shirudo-keepalive.service \
		systemd/shirudo-keepalive.timer \
		systemd/shirudo-bpm-repo-update.service \
		systemd/shirudo-bpm-repo-update.timer \
		systemd/shirudo-bpm-tree-sync.service \
		systemd/shirudo-bpm-tree-sync.timer
	@printf '  INSTALL $(DESTDIR)$(bindir)/shirudo (static mbedTLS)\n'
	$(Q)install -d $(DESTDIR)$(bindir)
	$(Q)install -m 0755 shirudo-target $(DESTDIR)$(bindir)/shirudo
	@printf '  INSTALL $(DESTDIR)$(systemdunitdir)/shirudo*.service,timer\n'
	$(Q)install -d $(DESTDIR)$(systemdunitdir)
	$(Q)install -m 0644 systemd/shirudo.service \
	    systemd/shirudo-map-export.service \
	    systemd/shirudo-map-export.timer \
	    systemd/shirudo-keepalive.service \
	    systemd/shirudo-keepalive.timer \
	    systemd/shirudo-bpm-repo-update.service \
	    systemd/shirudo-bpm-repo-update.timer \
	    systemd/shirudo-bpm-tree-sync.service \
	    systemd/shirudo-bpm-tree-sync.timer \
	    $(DESTDIR)$(systemdunitdir)/
	@printf '  INSTALL $(DESTDIR)$(SHIRUDO_JAVAAGENT_LIBDIR)/libshirudo_javaagent.so\n'
	$(Q)install -d $(DESTDIR)$(SHIRUDO_JAVAAGENT_LIBDIR)
	$(Q)install -m 0755 $(JAVAAGENT_BRIDGE) \
	    $(DESTDIR)$(SHIRUDO_JAVAAGENT_LIBDIR)/libshirudo_javaagent.so

install-operator: install shirudo-build bpf/vmlinux.h $(BPF_HEADERS_OUT) $(BPF_LIB_HEADERS)
	@printf '  INSTALL $(DESTDIR)$(libexecdir)/shirudo/shirudo-build\n'
	$(Q)install -d $(DESTDIR)$(libexecdir)/shirudo
	$(Q)install -m 0755 tools/shirudo-build/shirudo-build \
	    $(DESTDIR)$(libexecdir)/shirudo/shirudo-build
	@printf '  INSTALL $(DESTDIR)$(sharedir)/shirudo/vmlinux.h\n'
	$(Q)install -d $(DESTDIR)$(sharedir)/shirudo
	$(Q)install -m 0644 bpf/vmlinux.h \
	    $(DESTDIR)$(sharedir)/shirudo/vmlinux.h
	@printf '  INSTALL $(DESTDIR)$(SHIRUDO_BPF_INCDIR)/bpf/\n'
	$(Q)install -d $(DESTDIR)$(SHIRUDO_BPF_INCDIR)/bpf
	$(Q)install -m 0644 $(BPF_HEADERS_OUT) \
	    $(DESTDIR)$(SHIRUDO_BPF_INCDIR)/bpf/
	@printf '  INSTALL $(DESTDIR)$(SHIRUDO_BPF_INCDIR)/\n'
	$(Q)install -m 0644 $(BPF_LIB_HEADERS) \
	    $(DESTDIR)$(SHIRUDO_BPF_INCDIR)/

# ----- test -------------------------------------------------------

# Compiled test helpers (also usable as fuzz entry points).
TEST_HELPERS := t/helper/test-json-parser \
                t/helper/test-chain \
		 t/helper/test-mode \
		t/helper/test-config \
		t/helper/test-bpm-source \
		t/helper/test-kernel-release \
		t/helper/test-kernel-build-id \
                t/helper/test-bpf-load \
		t/helper/test-dns-prog-run \
                t/helper/test-kernel-abi \
                t/helper/test-otel-map \
                t/helper/test-upatch-map-types \
                t/helper/test-upatch-prog-metadata \
                t/helper/test-upatch-decode \
                t/helper/test-upatch-serializer-pages \
                t/helper/test-signed-load \
                t/helper/test-exec-churn

t/helper/test-json-parser: t/helper/test-json-parser.c util/json.o
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -o $@ $^

# chain.o's read/extend paths reference util/tpm (libtss2); the tests
# only exercise the pure helpers, but the symbols must still resolve.
# util/malloc.o brings in x*/shirudo_libc_free that chain.o/tpm.o use.
# util/config.o resolves shirudo_config_load(), called by tpm.o.
t/helper/test-chain: t/helper/test-chain.c util/chain.o util/crypto_openssl.o util/tpm.o util/log.o \
                     util/config.o util/malloc.o
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -o $@ $^ -lcrypto -lssl -ltss2-esys -ltss2-tctildr

t/helper/test-mode: t/helper/test-mode.c util/mode.o util/chain.o util/io.o \
			     util/crypto_openssl.o util/tpm.o util/log.o \
			     util/config.o util/malloc.o
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -o $@ $^ -lcrypto -lssl -ltss2-esys -ltss2-tctildr

t/helper/test-config: t/helper/test-config.c util/config.o util/io.o util/log.o
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -o $@ $^

t/helper/test-bpm-source: t/helper/test-bpm-source.c util/bpm_source_config.o
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -o $@ $^

t/helper/test-kernel-release: t/helper/test-kernel-release.c util/kernel_release.o
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -o $@ $^

t/helper/test-kernel-build-id: t/helper/test-kernel-build-id.c util/kernel_build_id.o
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -o $@ $^

t/helper/test-bpf-load: t/helper/test-bpf-load.c
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -o $@ $^

t/helper/test-dns-prog-run: t/helper/test-dns-prog-run.c
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -o $@ $^

# Needs the vendored uapi bpf.h (excl_prog_hash / fd_array_cnt / keyring_id
# are newer than a stock system header) and libcrypto for SHA-256.
t/helper/test-signed-load: t/helper/test-signed-load.c
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -Ithird_party/bpf-next/tools/include/uapi \
	    -o $@ $^ -lcrypto

t/helper/test-kernel-abi: t/helper/test-kernel-abi.c util/kernel_abi.o \
                          $(LIBBPF_A)
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -o $@ $^ $(LIBELF_LIBS) $(ZLIB_LIBS)

t/helper/test-otel-map: t/helper/test-otel-map.c util/upatch_maps.o \
                        util/upatch_maps_otel.o util/crypto_openssl.o util/serializer.o \
                        util/upatch_decode.o util/upatch_resolve.o \
                        util/upatch.o util/json.o \
                        util/io.o util/malloc.o $(LIBBPF_A)
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -o $@ $^ $(DYNAMIC_LIBS)

t/helper/test-upatch-map-types: t/helper/test-upatch-map-types.c
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -o $@ $^

t/helper/test-upatch-prog-metadata: t/helper/test-upatch-prog-metadata.c \
                                    util/upatch.o
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -o $@ $^

t/helper/test-upatch-serializer-pages: t/helper/test-upatch-serializer-pages.c \
                                       util/upatch_maps.o util/upatch_resolve.o \
                                       util/serializer.o \
                                       util/json.o util/malloc.o
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -o $@ $^ $(STATIC_LIBS) $(DYNAMIC_LIBS)

t/helper/test-upatch-decode: t/helper/test-upatch-decode.c \
			      util/upatch_decode.o util/upatch.o util/malloc.o
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -o $@ $^ $(DYNAMIC_LIBS)

t/helper/test-exec-churn: t/helper/test-exec-churn.c util/io.o
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -o $@ $^

test-helpers: $(TEST_HELPERS)

check test: shirudo $(TEST_HELPERS)
	@printf '  TEST\n'
	$(Q)cd t && ./run-tests.sh

# ----- clean ------------------------------------------------------

clean:
	$(Q)rm -f shirudo shirudo-target tools/shirudo-build/shirudo-build $(TEST_HELPERS)
	$(Q)rm -f $(MAIN_OBJ) $(BUILTIN_OBJS) $(UTIL_OBJS) \
	          $(BUILD_OBJS) $(VERSION_OBJ) util/version_id.c
	$(Q)rm -rf build/target
	$(Q)rm -f $(DEPS) t/helper/*.d
	$(Q)rm -f $(BPF_OBJS) bpf/vmlinux.h systemd/shirudo.service \
	          systemd/shirudo-map-export.service \
	          systemd/shirudo-keepalive.service \
	          systemd/shirudo-bpm-repo-update.service \
	          systemd/shirudo-bpm-tree-sync.service
	$(Q)rm -f $(JAVAAGENT_BRIDGE)
	$(Q)rm -rf bpf/include

distclean:
	$(Q)$(MAKE) -C $(LIBBPF_SOURCE_DIR) clean 2>/dev/null || true
	$(Q)$(MAKE) -C $(BPFTOOL_SOURCE_DIR) clean 2>/dev/null || true
