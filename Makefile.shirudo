# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 Authors of shirudo
#
# Makefile.shirudo -- main build graph.
#
# Five strict build phases (see PLAN.md "Build phases"):
#   1. submodule libraries (libbpf.a, libelf.a, bpftool)
#   2. generated headers   (bpf/vmlinux.h)
#   3. compiled objects    (util/*.o, builtin-*.o, shirudo.o, bpf/*.bpf.o)
#   4. embedded BPF        (util/loader.o, .incbin of bpf/*.bpf.o)
#   5. link                (shirudo, shirudo-build)

-include config.mk

# ----- toolchain --------------------------------------------------

CC      ?= cc
LD      := $(CC)
LDFLAGS ?=
SHIRUDO_BUNDLE_RPATH ?= 0
CLANG   ?= clang
BPFTOOL ?= third_party/bpf-next/tools/bpf/bpftool/bpftool

SHIRUDO_LIBEXEC_DIR ?= $(libexecdir)/shirudo

# Where operator-installed BPF headers live on a packaged host;
# also baked into shirudo-build as a runtime fallback -I path.
SHIRUDO_VAR_DIR     ?= /var/lib/shirudo
SHIRUDO_BPF_INCDIR  ?= $(SHIRUDO_VAR_DIR)/bpf/include

WARNINGS := -Wall -Wextra -Wno-unused-parameter -Wstrict-prototypes \
            -Wmissing-prototypes -Wpointer-arith -Wshadow

CFLAGS_BASE := -O2 -g -std=gnu11 $(WARNINGS) \
               -D_FILE_OFFSET_BITS=64 -D_GNU_SOURCE \
               -DSHIRUDO_LIBEXEC_DIR='"$(SHIRUDO_LIBEXEC_DIR)"' \
               -DSHIRUDO_BPF_INCDIR='"$(SHIRUDO_BPF_INCDIR)"'

INCLUDES := \
    -I. \
    -Iinclude \
    -Iutil \
    -Ithird_party/bpf-next/tools/lib \
    -Ithird_party/bpf-next/tools/include/uapi

CFLAGS := $(CFLAGS_BASE) $(INCLUDES) \
          $(LIBCRYPTO_CFLAGS) $(LIBSSH_CFLAGS) $(TSS2_CFLAGS) \
          $(LIBELF_CFLAGS) $(ZLIB_CFLAGS)

# Static-link these; dynamic-link the rest (libcrypto, libssh, tss2).
STATIC_LIBS := \
    third_party/bpf-next/tools/lib/bpf/libbpf.a

DYNAMIC_LIBS := \
    $(LIBCRYPTO_LIBS) $(LIBSSH_LIBS) $(TSS2_LIBS) \
    $(LIBELF_LIBS) $(ZLIB_LIBS)

ifeq ($(SHIRUDO_BUNDLE_RPATH),1)
RPATH_LDFLAGS := -Wl,--disable-new-dtags -Wl,-rpath,'$$ORIGIN/../lib/shirudo'
else
RPATH_LDFLAGS :=
endif

# vmlinux.h dumps anonymous structs in a way that trips
# -Wmissing-declarations; the BPF_PROG() / BPF_KPROBE() macros
# generate auto-named params that often go unused. Neither is
# fixable upstream of us, so silence both for BPF compilation.
CLANG_BPF := $(CLANG) -target bpf -O2 -g -Wall -Wextra \
             -Wno-missing-declarations -Wno-unused-parameter

# ----- source manifests -------------------------------------------

UTIL_SRCS := \
    util/parse-options.c \
    util/loader.c \
    util/upatch.c \
    util/keyring.c \
    util/paths.c \
    util/harden.c \
    util/preflight.c \
    util/ssh.c \
    util/log.c \
    util/tpm.c \
    util/chain.c \
    util/config.c \
    util/eventlog.c \
    util/json.c \
    util/report.c \
    util/selector.c \
    util/remotes.c \
    util/malloc.c \
    util/sysinfo.c \
    util/similar.c \
    util/seal.c

BUILTIN_SRCS := \
    builtin-init.c \
    builtin-genkey.c \
    builtin-status.c \
    builtin-keys.c \
    builtin-upatch.c \
    builtin-rollout.c \
    builtin-nodes.c \
    builtin-remote.c \
    builtin-build.c \
    builtin-version.c

# BPF-side libbpf headers we vendor at build time. bpf_helper_defs.h
# is generated by libbpf's own Makefile, so this list depends on
# LIBBPF_A. Copies into bpf/include/bpf/ so the BPF compile rule
# can use the kernel-selftest -I convention (`<bpf/...>`).
BPF_VENDOR_HEADERS := bpf_helpers bpf_helper_defs bpf_tracing \
                      bpf_core_read bpf_endian
BPF_HEADERS_OUT    := $(addprefix bpf/include/bpf/,\
                                  $(addsuffix .h,$(BPF_VENDOR_HEADERS)))

# bpf/*.bpf.c sources compiled with clang -target bpf and embedded via
# .incbin into util/loader.o. bpf/lib/ is include-only.
BPF_SRCS := \
    bpf/bpf2.c \
    bpf/seal.c \
    bpf/unload.c

# shirudo-build is operator-only and links util/sign.c (CMS signer)
# plus a small subset of util/. The core shirudo binary does NOT
# link util/sign.c.
BUILD_SRCS := \
    tools/shirudo-build/shirudo-build.c \
    tools/shirudo-build/compile.c \
    tools/shirudo-build/package.c \
    tools/shirudo-build/vmlinux.c

# ----- derived names ----------------------------------------------

UTIL_OBJS    := $(UTIL_SRCS:.c=.o)
BUILTIN_OBJS := $(BUILTIN_SRCS:.c=.o)
BPF_OBJS     := $(BPF_SRCS:.c=.bpf.o)
BUILD_OBJS   := $(BUILD_SRCS:.c=.o)

MAIN_OBJ     := shirudo.o
VERSION_OBJ  := util/version_id.o

# Header-dependency tracking (-MMD -MP writes a .d per .o). Without this,
# changing a header would leave dependent .o files stale -- e.g. a struct
# whose size grew in a header but whose .c was not re-touched, producing
# an ABI mismatch and memory corruption at runtime.
DEP_OBJS := $(MAIN_OBJ) $(BUILTIN_OBJS) $(UTIL_OBJS) $(VERSION_OBJ) \
            $(BUILD_OBJS)
DEPS     := $(DEP_OBJS:.o=.d)

# ----- top-level goals --------------------------------------------

.PHONY: all install install-target install-operator clean distclean check test \
        bpf libbpf bpftool

all: shirudo

# shirudo-build is built only when explicitly requested or on the
# operator install target.
shirudo-build: tools/shirudo-build/shirudo-build

# ----- phase 1: submodule libraries -------------------------------

LIBBPF_DIR := third_party/bpf-next/tools/lib/bpf
LIBBPF_A   := $(LIBBPF_DIR)/libbpf.a

libbpf: $(LIBBPF_A)

# libbpf's Makefile has no narrow "libbpf.a" target; the default
# target builds both libbpf.a, libbpf.so, and the generated
# bpf_helper_defs.h that BPF programs include. We consume libbpf.a
# and bpf_helper_defs.h; the .so is harmless byproduct.
$(LIBBPF_A):
	@printf '  LIBBPF\n'
	$(Q)$(MAKE) -C $(LIBBPF_DIR)

BPFTOOL_DIR := third_party/bpf-next/tools/bpf/bpftool

bpftool: $(BPFTOOL)

$(BPFTOOL):
	@printf '  BPFTOOL\n'
	$(Q)$(MAKE) -C $(BPFTOOL_DIR)

# ----- phase 2: generated headers ---------------------------------

bpf/vmlinux.h: $(BPFTOOL)
	@printf '  GEN     $@\n'
	$(Q)$< btf dump file /sys/kernel/btf/vmlinux format c > $@

# ----- phase 3: compile rules -------------------------------------

%.o: %.c
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

-include $(DEPS)

# Vendor the BPF-side libbpf headers into bpf/include/bpf/. The
# generated bpf_helper_defs.h only exists after libbpf is built.
$(BPF_HEADERS_OUT): bpf/include/bpf/%.h: \
		    third_party/bpf-next/tools/lib/bpf/%.h | $(LIBBPF_A)
	@printf '  COPY    $@\n'
	$(Q)mkdir -p $(dir $@)
	$(Q)cp $< $@

# BPF objects pull <bpf/...> headers from the in-tree vendor dir,
# vmlinux.h from bpf/, and UAPI kernel headers from the submodule.
bpf/%.bpf.o: bpf/%.c bpf/vmlinux.h $(BPF_HEADERS_OUT)
	@printf '  CLANG   $@\n'
	$(Q)$(CLANG_BPF) -Ibpf -Ibpf/lib -Ibpf/include \
	    -Ithird_party/bpf-next/tools/include/uapi \
	    -c $< -o $@

# ----- version_id ------------------------------------------------

# Regenerated every build; cheap (one sha256sum invocation).
.PHONY: util/version_id.c
util/version_id.c:
	@printf '  GEN     $@\n'
	$(Q)set -eu; \
	describe=$$(git describe --tags --always --dirty 2>/dev/null || cat VERSION); \
	describe_c=$$(printf '%s' "$$describe" | sed 's/[\\"]/\\&/g'); \
	rev=$$(git rev-parse HEAD 2>/dev/null || cat VERSION); \
	dirty=$$(git diff-index --quiet HEAD 2>/dev/null || echo -dirty); \
	cfg=$$(sha256sum config.mk Makefile.shirudo 2>/dev/null | \
	       sha256sum | cut -c1-16); \
	id=$$(printf '%s%s|%s' "$$rev$$dirty" "$$cfg" | \
	      sha256sum | cut -d' ' -f1); \
	{ \
	    echo "// SPDX-License-Identifier: BSD-2-Clause"; \
	    echo "/* Copyright (c) 2026 Authors of shirudo */"; \
	    echo "/* AUTO-GENERATED. Do not edit. Do not commit. */"; \
	    echo ""; \
	    echo "const char shirudo_version[] = \"$$describe_c\";"; \
	    echo "const char shirudo_version_id[] = \"$$id\";"; \
	} > $@

# ----- phase 5: link ---------------------------------------------

shirudo: $(MAIN_OBJ) $(BUILTIN_OBJS) $(UTIL_OBJS) $(VERSION_OBJ) $(LIBBPF_A)
	@printf '  LD      $@\n'
	$(Q)$(LD) $(CFLAGS) $(LDFLAGS) $(RPATH_LDFLAGS) -o $@ \
	    $(MAIN_OBJ) $(BUILTIN_OBJS) $(UTIL_OBJS) $(VERSION_OBJ) \
	    $(STATIC_LIBS) $(DYNAMIC_LIBS)

# util/loader.o has a make-level dep on every embedded bpf object.
util/loader.o: $(BPF_OBJS)

# shirudo-build links util/sign.c (CMS signer) plus a subset of util,
# plus util/loader.o for its .incbin of bpf/unload.bpf.o (used by
# the --unload directive emission path). Not linked into the core
# shirudo binary.
tools/shirudo-build/shirudo-build: $(BUILD_OBJS) util/sign.o \
                                   util/parse-options.o util/upatch.o \
                                   util/log.o util/json.o util/loader.o \
                                   util/malloc.o util/paths.o \
                                   $(LIBBPF_A)
	@printf '  LD      $@\n'
	$(Q)$(LD) $(CFLAGS) $(LDFLAGS) $(RPATH_LDFLAGS) -o $@ $^ $(STATIC_LIBS) $(DYNAMIC_LIBS)

# ----- install ----------------------------------------------------

# The reboot-persistence unit, with @bindir@ resolved to the install path.
systemd/shirudo.service: systemd/shirudo.service.in
	@printf '  GEN     $@\n'
	$(Q)sed 's|@bindir@|$(bindir)|g' $< > $@

# Common to both roles: the one shirudo binary + its completion.
install: shirudo
	@printf '  INSTALL $(DESTDIR)$(bindir)/shirudo\n'
	$(Q)install -d $(DESTDIR)$(bindir)
	$(Q)install -m 0755 shirudo $(DESTDIR)$(bindir)/shirudo
	@printf '  INSTALL $(DESTDIR)$(completionsdir)/shirudo\n'
	$(Q)install -d $(DESTDIR)$(completionsdir)
	$(Q)install -m 0644 completion/shirudo.bash \
	    $(DESTDIR)$(completionsdir)/shirudo

# Target machines additionally get the reboot-persistence unit. It runs
# `shirudo init`, which is target-only -- the operator never runs it, so
# the unit is deliberately NOT in install-operator.
install-target: install systemd/shirudo.service
	@printf '  INSTALL $(DESTDIR)$(systemdunitdir)/shirudo.service\n'
	$(Q)install -d $(DESTDIR)$(systemdunitdir)
	$(Q)install -m 0644 systemd/shirudo.service \
	    $(DESTDIR)$(systemdunitdir)/shirudo.service

install-operator: install shirudo-build $(BPF_HEADERS_OUT)
	@printf '  INSTALL $(DESTDIR)$(libexecdir)/shirudo/shirudo-build\n'
	$(Q)install -d $(DESTDIR)$(libexecdir)/shirudo
	$(Q)install -m 0755 tools/shirudo-build/shirudo-build \
	    $(DESTDIR)$(libexecdir)/shirudo/shirudo-build
	@printf '  INSTALL $(DESTDIR)$(SHIRUDO_BPF_INCDIR)/bpf/\n'
	$(Q)install -d $(DESTDIR)$(SHIRUDO_BPF_INCDIR)/bpf
	$(Q)install -m 0644 $(BPF_HEADERS_OUT) \
	    $(DESTDIR)$(SHIRUDO_BPF_INCDIR)/bpf/

# ----- test -------------------------------------------------------

# Compiled test helpers (also usable as fuzz entry points).
TEST_HELPERS := t/helper/test-json-parser \
                t/helper/test-chain \
                t/helper/test-selector \
                t/helper/test-bpf-load

t/helper/test-json-parser: t/helper/test-json-parser.c util/json.o
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -o $@ $^

# chain.o's read/extend paths reference util/tpm (libtss2); the tests
# only exercise the pure helpers, but the symbols must still resolve.
# util/malloc.o brings in x*/shirudo_libc_free that chain.o/tpm.o use.
t/helper/test-chain: t/helper/test-chain.c util/chain.o util/tpm.o util/log.o \
                     util/malloc.o
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -o $@ $^ -lcrypto -ltss2-esys -ltss2-tctildr

t/helper/test-selector: t/helper/test-selector.c util/selector.o \
                        util/remotes.o util/malloc.o util/log.o
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -o $@ $^

t/helper/test-bpf-load: t/helper/test-bpf-load.c
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) -o $@ $^

check test: shirudo $(TEST_HELPERS)
	@printf '  TEST\n'
	$(Q)cd t && ./run-tests.sh

# ----- clean ------------------------------------------------------

clean:
	$(Q)rm -f shirudo tools/shirudo-build/shirudo-build $(TEST_HELPERS)
	$(Q)rm -f $(MAIN_OBJ) $(BUILTIN_OBJS) $(UTIL_OBJS) \
	          $(BUILD_OBJS) $(VERSION_OBJ) util/version_id.c
	$(Q)rm -f $(DEPS) t/helper/*.d
	$(Q)rm -f $(BPF_OBJS) bpf/vmlinux.h systemd/shirudo.service
	$(Q)rm -rf bpf/include

distclean:
	$(Q)$(MAKE) -C $(LIBBPF_DIR) clean 2>/dev/null || true
	$(Q)$(MAKE) -C $(BPFTOOL_DIR) clean 2>/dev/null || true
